<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SwitchEnv — 环境变量管理" Width="1240" Height="820" MinWidth="1030" MinHeight="620" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Background="#F8FAF9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EFF3F0" BorderBrush="#DFE6E1" BorderThickness="0,0,1,0">
      <Grid Margin="18,24,18,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,25">
          <StackPanel Orientation="Horizontal"><Border Background="#204D3F" CornerRadius="9" Width="35" Height="35"><TextBlock Text="⇄" Foreground="White" FontSize="26" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="SwitchEnv" FontSize="23" FontWeight="SemiBold" Margin="10,1,0,0"/></StackPanel>
          <TextBlock Text="环境变量，按需组合" Foreground="#7C8A81" FontSize="12" Margin="0,12,0,0"/>
        </StackPanel>
        <Button Grid.Row="1" x:Name="EnvironmentNav" Style="{StaticResource NavButton}" Content="▦   本机环境" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="2" Margin="12,0,4,12" Text="配置组" Foreground="#8B9890" FontSize="11" FontWeight="SemiBold"/>
        <Grid Grid.Row="3" Margin="4,0,4,11"><TextBox x:Name="ProfileSearch" Background="#E5ECE6" BorderThickness="0" Padding="11,8" FontSize="12"/><TextBlock Text="搜索配置组…" Foreground="#97A298" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ProfileSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Text.Length, ElementName=ProfileSearch}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock></Grid>
        <ListBox Grid.Row="4" x:Name="ProfilesBox">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="12,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#8A978D" FontSize="11" Margin="0,7,0,0"/></StackPanel><ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsActive, Mode=OneWay}" Tag="{Binding Id}" VerticalAlignment="Center" ToolTip="启用或停用配置组"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="5" Margin="0,12,0,15"><Button x:Name="AddProfile" Content="＋  新建配置组" HorizontalContentAlignment="Center" Background="Transparent"/><Button x:Name="HistoryNav" Content="◷   切换记录" Style="{StaticResource NavButton}" Margin="0,15,0,0"/><Grid Margin="1,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ImportButton" Content="↓  导入" Style="{StaticResource QuietButton}" Padding="10,9"/><Button Grid.Column="1" x:Name="ExportButton" Content="↑  导出" Style="{StaticResource QuietButton}" Padding="10,9"/></Grid></StackPanel>
        <StackPanel Grid.Row="6"><Border Height="1" Background="#DDE5DE" Margin="0,0,0,13"/><Grid Margin="10,0,10,10"><StackPanel><TextBlock Text="开机自启" Foreground="#667570" FontSize="11"/><TextBlock Text="管理员 · 登录后驻留托盘" Foreground="#99A59D" FontSize="10" Margin="0,4,0,0"/></StackPanel><ToggleButton x:Name="StartupToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="管理员开机自启"/></Grid><Button x:Name="AdminButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,5" FontSize="11"/><Grid Margin="10,9,4,0"><TextBlock Text="便携版  ·  0.2.2" Foreground="#A2ADA5" FontSize="10"/><Button x:Name="HelpButton" Content="使用帮助" Style="{StaticResource QuietButton}" Padding="0" FontSize="10" HorizontalAlignment="Right"/></Grid></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock x:Name="Breadcrumb" Text="工作区  /  配置组" Foreground="#8A9790" FontSize="11"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Fill="#247D63" Width="6" Height="6" Margin="0,0,6,0"/><TextBlock x:Name="GlobalStatus" MaxWidth="350" TextTrimming="CharacterEllipsis" Foreground="#718078" FontSize="11"/></StackPanel></Grid>
      <Border Grid.Row="1" x:Name="RecoveryBanner" Visibility="Collapsed" Background="#FFF3DE" CornerRadius="6" Margin="0,16,0,0" Padding="14,10"><DockPanel><Button x:Name="RecoverButton" DockPanel.Dock="Right" Content="恢复未完成的修改" Padding="12,5"/><TextBlock Text="发现未完成的修改，恢复后可继续切换。" VerticalAlignment="Center" Foreground="#986A22"/></DockPanel></Border>
      <Grid Grid.Row="2" Margin="0,23,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="#88968D" FontSize="12" Margin="0,10,24,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource QuietButton}" Margin="0,0,7,0"/><Button x:Name="TerminalButton" Content="新建终端" Margin="0,0,10,0"/><Button x:Name="StopButton" Content="停用此组" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="启用配置组"/><Button x:Name="ProfileMenuButton" Content="•••" Padding="10,9" Margin="10,0,0,0" ToolTip="配置组设置"/></StackPanel></Grid>
      <StackPanel Grid.Row="3">
        <Border x:Name="SummaryPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="22,19" Margin="0,0,0,26"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="配置组变量" Foreground="#93A095" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="VariableCount" FontSize="23" FontWeight="SemiBold"/><TextBlock Text=" 个" Foreground="#9AA59D" FontSize="12" Margin="5,10,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="作用范围" Foreground="#93A095" FontSize="11"/><TextBlock x:Name="ScopeSummary" FontSize="15" Margin="0,13,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="20,0"><TextBlock Text="运行状态" Foreground="#93A095" FontSize="11"/><TextBlock x:Name="ActiveSummary" FontSize="15" Margin="0,13,0,0" Foreground="#247D63"/></StackPanel></Grid></Border>
        <Grid x:Name="VariableToolbar" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel VerticalAlignment="Top"><Grid Width="150" Margin="0,0,0,4"><TextBox x:Name="VariableSearch" Padding="11,8"/><TextBlock Text="查找变量…" Foreground="#9CA69F" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=VariableSearch}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="ScopeFilter" Width="100" Margin="10,0,0,4" SelectedIndex="0"><ComboBoxItem Content="全部范围"/><ComboBoxItem Content="用户变量"/><ComboBoxItem Content="系统变量"/></ComboBox><ComboBox x:Name="ApplicationFilter" Width="145" Margin="10,0,0,4" SelectedIndex="0" Visibility="Collapsed" ToolTip="应用方式：筛选本机值或配置组管理的变量" AutomationProperties.Name="应用方式筛选"><ComboBoxItem Content="全部方式" Tag="all"/><ComboBoxItem Content="本机值" Tag="local"/><ComboBoxItem Content="配置组管理" Tag="managed"/></ComboBox><CheckBox x:Name="RevealValues" Content="显示敏感值" Foreground="#7A897E" FontSize="11" VerticalAlignment="Center" Margin="14,8,0,4"/></WrapPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="EditVariable" Content="编辑" Style="{StaticResource QuietButton}" Padding="9,9"/><Button x:Name="MoveVariable" Content="移动" Style="{StaticResource QuietButton}" Padding="9,9" ToolTip="移动到本机用户/系统变量，或其他配置组"/><Button x:Name="DeleteVariable" Content="删除" Style="{StaticResource QuietButton}" Padding="9,9" Margin="2,0,8,0"/><Button x:Name="AddVariable" Content="＋  添加变量" Padding="13,9"/></StackPanel></Grid>
      </StackPanel>
      <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="VariablesGrid" SelectionMode="Extended" ToolTip="勾选变量，或用 Ctrl / Shift 多选；Ctrl+A 全选当前列表">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="0"/></Style></DataGridTemplateColumn.CellStyle><DataGridTemplateColumn.Header><CheckBox Focusable="False" IsThreeState="True" HorizontalAlignment="Center" ToolTip="全选或取消选择当前列表" AutomationProperties.Name="全选当前列表"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Mode=OneWay}" ToolTip="选择或取消选择此变量" AutomationProperties.Name="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="156"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#334B3E"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              <DataGridTextColumn Header="变量值" Binding="{Binding DisplayValue}" Width="2*" MinWidth="95" ElementStyle="{StaticResource CellText}"/>
              <DataGridTemplateColumn Header="范围" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#EDF3EF" CornerRadius="4" Padding="6,4" HorizontalAlignment="Left"><TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="#668673"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="应用方式" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding OwnerExplanation}"><TextBlock Text="{Binding ModeText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OwnerText}" FontSize="10" Foreground="#819589" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OwnerText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding OwnerText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="值类型" Binding="{Binding KindText}" Width="88" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="115">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Description}" Value=""><Setter Property="ToolTipService.IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid x:Name="HistoryGrid" Visibility="Collapsed"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="180" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="操作" Binding="{Binding Label}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="修改变量" Binding="{Binding Count}" Width="110" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
          <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="＋" FontSize="35" Foreground="#BCD0C1" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="从一个变量开始" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="EmptySubtitle" Text="添加 JAVA_HOME、代理地址或一组 PATH 目录" Foreground="#95A197" Margin="0,10,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="5" x:Name="InfoPanel" Background="#ECF3EE" CornerRadius="6" Margin="0,17,0,0" Padding="14,11"><DockPanel><TextBlock Text="ⓘ" Foreground="#79A388" FontSize="14" Margin="0,0,9,0"/><TextBlock x:Name="InfoText" Text="配置组修改会自动保存，启用后才会写入 Windows 环境变量。" Foreground="#75927E" FontSize="11" TextWrapping="Wrap"/></DockPanel></Border>
      <Grid Grid.Row="6" Margin="0,17,0,0"><TextBlock x:Name="StatusText" Foreground="#7B8A80" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,275,0"/><TextBlock x:Name="TableCount" Foreground="#A1ADA3" FontSize="11" HorizontalAlignment="Right"/></Grid>
    </Grid>
  </Grid>
</Window>
